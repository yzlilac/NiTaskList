[Unit]
Description=Gin task list web app
After=network.target

[Service]
WorkingDirectory=/opt/gin-task-list
DynamicUser=yes
StateDirectory=gin-task-list
StateDirectoryMode=0700
Environment=TASK_LIST_DATA_DIR=/var/lib/gin-task-list
ExecStart=/opt/gin-task-list/.venv/bin/waitress-serve --listen=127.0.0.1:18080 --max-request-body-size=4096 --call app:create_app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
